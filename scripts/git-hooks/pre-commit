#!/usr/bin/env bash
# pre-commit — gate ligero antes de cada commit (AGENTS.md §1.1).
# Solo sintaxis del <script> de index.html (<1s); la suite completa va en verify.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -qx 'index.html'; then
  node scripts/check-syntax.js || { echo "pre-commit: error de sintaxis en index.html, commit bloqueado."; exit 1; }
fi
exit 0
